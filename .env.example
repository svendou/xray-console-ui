# 后台不自动加载 .env。由 systemd EnvironmentFile 或 shell 提供。
# 推荐用权限为 0600 的文件保存密码；不要在源码中填写真实密钥。
PANEL_PASSWORD_FILE=/etc/xray-console-ui/password
PANEL_HOST=0.0.0.0
PANEL_PORT=8787
# 端口映射直连 HTTP 时启用。公网长期使用建议改用 HTTPS 反向代理并删除此项。
PANEL_ALLOW_INSECURE_HTTP=1
# 使用 HTTPS 反代时填写实际访问来源（不含尾随斜杠）
# PANEL_ORIGIN=https://panel.example.com
